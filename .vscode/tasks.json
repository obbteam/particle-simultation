{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-sfml",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/source/verlet.cpp",
        "-I${workspaceFolder}/include",
        "-L${workspaceFolder}/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system",
        "-std=c++20",
        "-o",
        "${workspaceFolder}/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}